# 이 파일을 .env로 복사한 뒤 API 키를 채워 넣으세요.

# 수업용 aiclab vLLM 서버 (채팅 + 임베딩 + 리랭커, 키 하나로 모두 사용)
API_KEY=your-key-here
BASE_URL=https://llm.aiclab.dev/v1
MODEL=qwen3-14b
DISABLE_THINKING=1          # Qwen3의 긴 '생각' 과정을 끄고 바로 답하게 함 (vLLM 전용)

EMBED_BASE_URL=https://embed.aiclab.dev/v1     # ③ 의미 검색 (OpenAI 호환 /v1/embeddings)
EMBED_MODEL=bge-m3
RERANK_BASE_URL=https://rerank.aiclab.dev/v1   # ④ 리랭커 (vLLM /v1/rerank)
RERANK_MODEL=bge-reranker-v2-m3

# PDF 채팅 (선택)
# MAX_PDF_CHARS=40000   # ① 전체 붙여 넣기 최대 글자 수. qwen3-14b 문맥은 32k 토큰이라 한국어 약 4만 자가 상한
# CHUNK_SIZE=500        # 문단이 이보다 길면 이 길이로 자름
# TOP_K=3               # 검색에서 고를 청크 수
# RERANK_CANDIDATES=10  # ④에서 임베딩으로 먼저 추리는 후보 수

# 다른 OpenAI 호환 API를 쓰려면 (③④는 EMBED_/RERANK_ 서버가 따로 필요)
# BASE_URL=https://api.groq.com/openai/v1   MODEL=openai/gpt-oss-120b   MAX_PDF_CHARS=10000  (무료 등급 8,000 TPM)
# BASE_URL=https://api.x.ai/v1              MODEL=grok-3-mini
